// Pipeline CI du backend SouverainRecrut.
//
// Étapes : installation, génération Prisma, tests + couverture, analyse SonarQube
// + Quality Gate, build de l'image Docker, scan Trivy, publication sur Docker Hub.
//
// La publication n'a lieu que si tous les contrôles précédents sont verts, et seulement
// quand DOCKERHUB_NAMESPACE est renseigné (sinon l'étape est ignorée).
//
// Prérequis Jenkins : credential « sonar-token », serveur SonarQube nommé « sonar »,
// credential « docker_hub » (type Secret text : l'Access Token Docker Hub) pour la publication
// (voir integration-continue/README.md).

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    // Scrutation de la branche Dev toutes les 5 minutes (Jenkins local : pas de webhook GitHub).
    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        // Base PostgreSQL jetable du compose « outils » (service postgres-ci).
        DATABASE_URL = "${env.TEST_DATABASE_URL}"
        CI = 'true'

        IMAGE_NAME = 'souverainrecrut-backend'
        // Version figée de Trivy (pas de « latest »).
        TRIVY = 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache aquasec/trivy:0.76.2'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Installation') {
            steps {
                dir('backend') {
                    sh 'node --version && npm --version'
                    sh 'npm ci'
                }
            }
        }

        stage('Prisma') {
            steps {
                dir('backend') {
                    sh 'npx prisma generate'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('backend') {
                    // Applique les migrations sur la base de test, exécute les tests
                    // et produit coverage/lcov.info.
                    sh 'npm run test:coverage'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'backend/coverage/**', allowEmptyArchive: true
                }
            }
        }

        stage('Analyse SonarQube') {
            steps {
                dir('backend') {
                    // Injecte SONAR_HOST_URL et SONAR_AUTH_TOKEN (credential « sonar-token »).
                    // Le scanner attend le Quality Gate (sonar.qualitygate.wait=true) :
                    // un gate rouge fait échouer cette étape.
                    withSonarQubeEnv('sonar') {
                        sh '''
                            sonar-scanner \
                              -Dproject.settings=../integration-continue/sonar/sonar-project.properties \
                              -Dsonar.projectBaseDir=. \
                              -Dsonar.host.url="$SONAR_HOST_URL" \
                              -Dsonar.token="$SONAR_AUTH_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Image Docker') {
            steps {
                script {
                    // Tag traçable : version applicative + commit (ex. 1.0.0-21c7b79). Jamais « latest ».
                    def version = sh(returnStdout: true, script: "node -p \"require('./backend/package.json').version\"").trim()
                    def commit = sh(returnStdout: true, script: 'git rev-parse --short=7 HEAD').trim()
                    env.IMAGE_TAG = "${version}-${commit}"
                    env.IMAGE_REF = "${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                }
                sh '''
                    docker build \
                      --label org.opencontainers.image.version="$IMAGE_TAG" \
                      --label org.opencontainers.image.revision="$(git rev-parse HEAD)" \
                      -t "$IMAGE_REF" backend
                    docker image ls "$IMAGE_NAME"
                '''
            }
        }

        stage('Scan Trivy') {
            steps {
                sh '''
                    # 1. Rapport complet (JSON), archivé avec le build.
                    $TRIVY image --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed \
                      --no-progress --quiet --format json "$IMAGE_REF" > trivy-report.json

                    # 2. Affichage lisible dans les logs (HIGH et CRITICAL corrigeables).
                    $TRIVY image --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed \
                      --no-progress "$IMAGE_REF"

                    # 3. Barrière : échec s'il reste une faille CRITICAL pour laquelle un correctif existe.
                    $TRIVY image --scanners vuln --severity CRITICAL --ignore-unfixed \
                      --exit-code 1 --no-progress "$IMAGE_REF"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Publication Docker Hub') {
            // Ignorée tant que DOCKERHUB_NAMESPACE (compte Docker Hub) n'est pas renseigné.
            when { expression { return env.DOCKERHUB_NAMESPACE?.trim() } }
            steps {
                // Le token est le seul secret (credential « Secret text ») ; l'identifiant Docker Hub
                // n'est pas secret : c'est DOCKERHUB_NAMESPACE.
                withCredentials([string(credentialsId: 'docker_hub', variable: 'DH_TOKEN')]) {
                    sh '''
                        REMOTE_REF="$DOCKERHUB_NAMESPACE/$IMAGE_NAME:$IMAGE_TAG"
                        echo "$DH_TOKEN" | docker login -u "$DOCKERHUB_NAMESPACE" --password-stdin
                        docker tag "$IMAGE_REF" "$REMOTE_REF"
                        docker push "$REMOTE_REF"
                    '''
                }
            }
            post {
                always {
                    sh 'docker logout || true'
                }
            }
        }
    }

    post {
        success { echo 'Pipeline réussie.' }
        failure { echo 'Pipeline en échec : consulter les logs de l\'étape en erreur.' }
    }
}
