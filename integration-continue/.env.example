# Copier ce fichier vers .env (ignoré par git) et renseigner les valeurs.

# Mot de passe de la base PostgreSQL de SonarQube (choisir une valeur aléatoire).
# Exemple : openssl rand -base64 24
SONAR_DB_PASSWORD=change-me

# GID du groupe propriétaire du socket Docker de l'hôte.
# Commande : stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Identifiant Docker Hub (non secret). Laisser vide tant que le compte n'est pas créé :
# la pipeline ne publie alors pas l'image. Le token, lui, va dans les credentials Jenkins.
DOCKERHUB_NAMESPACE=
