# Image de développement local : Node 22 + OpenSSL (requis par Prisma).
# Utilisée uniquement par docker-compose.dev.yml, pas par la CI ni par la prod.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
